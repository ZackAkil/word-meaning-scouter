# Google Cloud Project & Gemini Settings
PROJECT_ID=zacks-sandbox
GCP_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash-lite

# Development Mode (true bypasses Valkey/Redis & reCAPTCHA for zero-config local dev)
DEV_MODE=true

# Production Security & Rate Limiting (set DEV_MODE=false to enable)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SCORE_THRESHOLD=0.5
REDIS_URL=redis://10.0.0.3:6379/0
GLOBAL_RATE_LIMIT=1000 per 5 minutes
PER_USER_RATE_LIMIT=10 per minute
MAX_BODY_BYTES=131072

# Optional Non-Blocking BigQuery Telemetry
BQ_DATASET=simple_demo_tracking
BQ_TABLE=demo_usage
DEMO_NAME=word-meaning-scouter
